# Vite Client Environment Configuration
# Public API origin and base path; this value must never contain server secrets.
# For local development, Vite proxies /api to the local Express server.
VITE_API_URL=/api
# The previous setting remains supported for existing deployments.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_TITLE=TimberCraft Saw Mill
