# ─────────────────────────────────────────────────────────────────
# Saw Mill Management System — Server Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit the real .env file to source control.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MySQL Database ────────────────────────────────────────────────
# All four DB_* variables are REQUIRED — the server will refuse to
# start if any are missing or empty.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=sawmill_db
DB_SSL=false
# In production, set this to the managed database CA certificate if required.
# It may contain the certificate text with \n line breaks.
DB_SSL_CA=

# ── JWT Authentication ────────────────────────────────────────────
# Use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_REFRESH_SECRET=replace_with_a_separate_long_random_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SAME_SITE=Lax
# Set to 1 when the hosting platform places one trusted proxy in front of Express.
TRUST_PROXY_HOPS=0


# ── CORS ──────────────────────────────────────────────────────────
# URL of the React frontend (Vite default port is 5173)
CLIENT_URL=http://localhost:5173

# ── Protected Health Check ────────────────────────────────────────
# Token required in the X-Health-Token header to call GET /api/db-health
# Leave blank to allow unauthenticated access in development only.
# In production this MUST be set to a strong secret.
HEALTH_CHECK_TOKEN=replace_with_a_secret_health_token

# ── Invoice / PDF business identity ───────────────────────────────
# Supply real registered business details before issuing customer PDFs.
MILL_NAME=
MILL_ADDRESS=
MILL_PHONE=
MILL_EMAIL=
MILL_TAX_ID=
